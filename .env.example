# Supabase (Project Settings → API). Use Frankfurt (eu-central-1).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role — seed script and server auth routes only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Used only by `npm run seed` to create Auth users for demo accounts.
# Must be at least 8 characters. Do not put this in NEXT_PUBLIC_* variables.
SEED_DEMO_PASSWORD=Altman1234
